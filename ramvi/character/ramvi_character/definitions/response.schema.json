{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ramvi:character:response:1",
  "oneOf": [
    {
      "$ref": "#/$defs/start"
    },
    {
      "$ref": "#/$defs/segment"
    },
    {
      "$ref": "#/$defs/end"
    }
  ],
  "$defs": {
    "emotion": {
      "enum": [
        "neutral"
      ]
    },
    "animation": {
      "enum": [
        "none"
      ]
    },
    "voice_style": {
      "enum": [
        "neutral"
      ]
    },
    "source": {
      "enum": [
        "current"
      ]
    },
    "candidate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        },
        "kind": {
          "enum": [
            "preference",
            "event",
            "fact"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "confidence",
        "evidence"
      ],
      "additionalProperties": false
    },
    "start": {
      "type": "object",
      "properties": {
        "type": {
          "const": "start"
        },
        "schema": {
          "const": "ramvi.character.response/1"
        },
        "intent": {
          "enum": [
            "answer",
            "clarify",
            "acknowledge",
            "decline"
          ]
        },
        "emotion": {
          "$ref": "#/$defs/emotion"
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "type",
        "schema",
        "intent",
        "emotion",
        "intensity"
      ],
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "properties": {
        "type": {
          "const": "segment"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "emotion": {
          "$ref": "#/$defs/emotion"
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "voice_style": {
          "$ref": "#/$defs/voice_style"
        },
        "animation": {
          "$ref": "#/$defs/animation"
        }
      },
      "required": [
        "type",
        "id",
        "seq",
        "text",
        "emotion",
        "intensity",
        "voice_style",
        "animation"
      ],
      "additionalProperties": false
    },
    "end": {
      "type": "object",
      "properties": {
        "type": {
          "const": "end"
        },
        "last_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "memory_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          },
          "maxItems": 4
        }
      },
      "required": [
        "type",
        "last_seq",
        "memory_candidates"
      ],
      "additionalProperties": false
    }
  }
}
