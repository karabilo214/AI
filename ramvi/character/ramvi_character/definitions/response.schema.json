{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ramvi:character:response:1",
  "oneOf": [
    {
      "$ref": "#/$defs/start"
    },
    {
      "$ref": "#/$defs/segment"
    },
    {
      "$ref": "#/$defs/end"
    }
  ],
  "$defs": {
    "emotion": {
      "enum": [
        "neutral"
      ]
    },
    "animation": {
      "enum": [
        "none"
      ]
    },
    "eyes": {
      "enum": [
        "normal"
      ]
    },
    "mouth": {
      "enum": [
        "neutral"
      ]
    },
    "move": {
      "type": "object",
      "properties": {
        "do": {
          "$ref": "#/$defs/animation"
        },
        "x": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "scale": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.4
        },
        "squash": {
          "type": "number",
          "minimum": 0.7,
          "maximum": 1.3
        },
        "eyes": {
          "$ref": "#/$defs/eyes"
        },
        "mouth": {
          "$ref": "#/$defs/mouth"
        },
        "ms": {
          "type": "integer",
          "minimum": 80,
          "maximum": 3000
        }
      },
      "required": [
        "ms"
      ],
      "additionalProperties": false
    },
    "voice_style": {
      "enum": [
        "neutral"
      ]
    },
    "source": {
      "enum": [
        "current"
      ]
    },
    "candidate": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        },
        "kind": {
          "enum": [
            "preference",
            "event",
            "fact"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "confidence",
        "evidence"
      ],
      "additionalProperties": false
    },
    "start": {
      "type": "object",
      "properties": {
        "type": {
          "const": "start"
        },
        "schema": {
          "const": "ramvi.character.response/1"
        },
        "intent": {
          "enum": [
            "answer",
            "clarify",
            "acknowledge",
            "decline"
          ]
        },
        "emotion": {
          "$ref": "#/$defs/emotion"
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reaction": {
          "enum": [
            "none",
            "consider",
            "explain",
            "calculate",
            "write",
            "code",
            "compare",
            "plan",
            "support"
          ]
        },
        "reaction_language": {
          "enum": [
            "ru",
            "en"
          ]
        }
      },
      "required": [
        "type",
        "schema",
        "intent",
        "emotion",
        "intensity"
      ],
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "properties": {
        "type": {
          "const": "segment"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "emotion": {
          "$ref": "#/$defs/emotion"
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "voice_style": {
          "$ref": "#/$defs/voice_style"
        },
        "animation": {
          "$ref": "#/$defs/animation"
        },
        "eyes": {
          "$ref": "#/$defs/eyes"
        },
        "mouth": {
          "$ref": "#/$defs/mouth"
        },
        "moves": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/move"
          },
          "maxItems": 8
        }
      },
      "required": [
        "type",
        "id",
        "seq",
        "text",
        "emotion",
        "intensity",
        "voice_style",
        "animation"
      ],
      "additionalProperties": false
    },
    "end": {
      "type": "object",
      "properties": {
        "type": {
          "const": "end"
        },
        "last_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "memory_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          },
          "maxItems": 4
        },
        "feedback": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feedback"
          },
          "maxItems": 2
        }
      },
      "required": [
        "type",
        "last_seq",
        "memory_candidates"
      ],
      "additionalProperties": false
    },
    "feedback": {
      "type": "object",
      "properties": {
        "dimension": {
          "enum": [
            "overall",
            "warmth",
            "humor",
            "sarcasm",
            "strictness",
            "curiosity",
            "verbosity",
            "initiative",
            "empathy"
          ]
        },
        "direction": {
          "enum": [
            -1,
            1
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ambiguous": {
          "type": "boolean"
        }
      },
      "required": [
        "dimension",
        "direction",
        "confidence",
        "ambiguous"
      ],
      "additionalProperties": false
    }
  }
}
