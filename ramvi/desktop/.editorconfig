root = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
insert_final_newline = true
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
# Публичные API приложения не библиотека: XML-документация не обязательна.
dotnet_diagnostic.CA1515.severity = none
# Тексты пользователю идут через каталог переводов, не через ресурсы .resx.
dotnet_diagnostic.CA1303.severity = none

[*.{axaml,csproj,props,slnx,json}]
indent_style = space
indent_size = 2
