<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Тесты: имена методов с подчёркиваниями, ConfigureAwait не нужен. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1515;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Ramvi.Desktop/Ramvi.Desktop.csproj" />
    <None Include="../../../i18n/*.json" Link="i18n/%(Filename).json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
