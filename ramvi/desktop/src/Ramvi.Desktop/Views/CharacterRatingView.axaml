<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="using:Ramvi.Desktop.Localization" xmlns:vm="using:Ramvi.Desktop.ViewModels"
 xmlns:conv="using:Avalonia.Data.Converters" x:Class="Ramvi.Desktop.Views.CharacterRatingView" x:DataType="vm:CharacterViewModel">
 <!-- «Оценить последний ответ» под персонажем слева -->
 <StackPanel x:Name="CharacterRating" IsVisible="{Binding CanRate}" Spacing="4" Margin="24,0,12,24">
  <TextBlock Text="{l:T character.rate_title}" Classes="muted"/>
  <WrapPanel>
   <Button Content="{l:T character.rate_good}" Command="{Binding RateCommand}" CommandParameter="overall:1" Margin="0,0,6,6"/>
   <Button Content="{l:T character.rate_bad}" Command="{Binding RateCommand}" CommandParameter="overall:-1" Margin="0,0,6,6"/>
   <Button Content="{l:T character.rate_shorter}" Command="{Binding RateCommand}" CommandParameter="verbosity:-1" Margin="0,0,6,6"/>
   <Button Content="{l:T character.rate_longer}" Command="{Binding RateCommand}" CommandParameter="verbosity:1" Margin="0,0,6,6"/>
   <Button Content="{l:T character.rate_less_humor}" Command="{Binding RateCommand}" CommandParameter="humor:-1" Margin="0,0,6,6"/>
   <Button Content="{l:T character.rate_more_humor}" Command="{Binding RateCommand}" CommandParameter="humor:1" Margin="0,0,6,6"/>
  </WrapPanel>
  <TextBlock Text="{Binding FeedbackStatus}" IsVisible="{Binding FeedbackStatus, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Classes="muted"/>
 </StackPanel>
</UserControl>
