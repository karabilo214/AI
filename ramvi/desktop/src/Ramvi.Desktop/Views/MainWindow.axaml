<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Ramvi.Desktop.Localization"
        xmlns:vm="using:Ramvi.Desktop.ViewModels"
        xmlns:api="using:Ramvi.Desktop.Api"
        x:Class="Ramvi.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{l:T app.title}"
        Width="1100" Height="720" MinWidth="720" MinHeight="480"
        DragDrop.AllowDrop="True">
  <Grid ColumnDefinitions="Auto,260,*">

    <!-- Разделы (3.11): видны, только если их больше одного -->
    <Border x:Name="SectionRail" Grid.Column="0" IsVisible="{Binding Sections.HasMany}"
            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
      <ListBox x:Name="SectionList" Width="120" Background="Transparent"
               ItemsSource="{Binding Sections.Items}" SelectedItem="{Binding Sections.Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SectionItem">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Раздел модуля (Agent/Character): вид создаётся при первом открытии и хранится -->
    <Border x:Name="ModuleSection" Grid.Column="1" Grid.ColumnSpan="2" IsVisible="{Binding !Sections.IsChatSelected}">
      <StackPanel Margin="24" Spacing="8" DataContext="{Binding Sections.Current}" x:DataType="vm:ModuleSectionViewModel">
        <TextBlock x:Name="ModuleTitle" FontSize="22" FontWeight="SemiBold" Text="{Binding Title, FallbackValue=''}" />
        <TextBlock x:Name="ModuleState" Text="{Binding State, FallbackValue=''}" />
        <TextBlock x:Name="ModuleError" Classes="error" TextWrapping="Wrap" Text="{Binding Error, FallbackValue=''}"
                   IsVisible="{Binding HasError, FallbackValue=False}" />
        <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding Placeholder, FallbackValue=''}" />
      </StackPanel>
    </Border>

    <!-- Список диалогов -->
    <DockPanel Grid.Column="1" IsVisible="{Binding Sections.IsChatSelected}"
               Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <Button x:Name="NewChatButton" DockPanel.Dock="Top" Margin="12" HorizontalAlignment="Stretch"
              Content="{l:T chat.new}" Command="{Binding NewChatCommand}" />
      <Button x:Name="SettingsButton" DockPanel.Dock="Bottom" Margin="12" HorizontalAlignment="Stretch"
              Content="{l:T settings.open}" Command="{Binding OpenSettingsCommand}" />
      <TextBlock DockPanel.Dock="Top" Margin="16,4" Opacity="0.6" Text="{l:T chat.no_chats}"
                 IsVisible="{Binding !HasChats}" />
      <ListBox x:Name="ChatList" ItemsSource="{Binding Chats}" SelectedItem="{Binding SelectedChat}"
               Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ChatItemViewModel">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis">
              <TextBlock.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{l:T chat.delete}"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteChatCommand}"
                            CommandParameter="{Binding}" />
                </ContextMenu>
              </TextBlock.ContextMenu>
            </TextBlock>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Диалог -->
    <DockPanel x:Name="ChatPanel" Grid.Column="2" IsVisible="{Binding Sections.IsChatSelected}">
      <!-- Верхняя полоса: модель, очистка -->
      <Grid DockPanel.Dock="Top" Margin="12,8" ColumnDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="{l:T chat.model}" />
        <ComboBox x:Name="ModelBox" Grid.Column="1" MinWidth="240" HorizontalAlignment="Left"
                  ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                  IsDropDownOpen="{Binding IsModelPickerOpen}"
                  IsEnabled="{Binding IsIdle}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="api:ModelInfo">
              <TextBlock Text="{Binding Id}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button x:Name="DeleteButton" Grid.Column="2" Margin="8,0,0,0" Content="{l:T chat.delete}"
                Command="{Binding DeleteChatCommand}" />
        <Button x:Name="ClearButton" Grid.Column="3" Margin="8,0,0,0" Content="{l:T chat.clear}"
                Command="{Binding ClearCommand}" />
      </Grid>

      <!-- Плашка состояния UI-03: что случилось и кнопки восстановления -->
      <Border x:Name="StateBanner" DockPanel.Dock="Top" Margin="12,0,12,8" Padding="12,8" CornerRadius="8"
              IsVisible="{Binding HasBanner}"
              Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
              Classes.problem="{Binding Banner.IsProblem, FallbackValue=False}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock x:Name="StateTitle" FontWeight="SemiBold" Text="{Binding Banner.Title, FallbackValue=''}" />
            <TextBlock x:Name="StateText" TextWrapping="Wrap" Text="{Binding Banner.Text, FallbackValue=''}" />
          </StackPanel>
          <ItemsControl x:Name="StateActions" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                        ItemsSource="{Binding Banner.Actions, FallbackValue={x:Null}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StateAction">
                <Button Content="{Binding Label}" Command="{Binding Command}" CommandParameter="{Binding Parameter}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <!-- Строка состояния -->
      <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="12,0,12,8" Opacity="0.75"
                 Text="{Binding Status}" TextWrapping="Wrap"
                 Classes.error="{Binding IsError}" />

      <!-- Поле ввода -->
      <Grid DockPanel.Dock="Bottom" Margin="12,4" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
        <ItemsControl Grid.Row="0" Grid.ColumnSpan="2" ItemsSource="{Binding Attachments}" Margin="0,0,0,4">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AttachmentViewModel">
              <Border Margin="0,0,6,4" Padding="8,2" CornerRadius="10"
                      Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                  <Button Padding="4,0" Content="×" ToolTip.Tip="{l:T chat.remove_attachment}"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveAttachmentCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox x:Name="InputBox" Grid.Row="1" Grid.Column="0" MinHeight="44" MaxHeight="200"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 PlaceholderText="{l:T chat.input_placeholder}" Text="{Binding Input}" />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0"
                    VerticalAlignment="Bottom">
          <Button x:Name="RegenerateButton" Content="{l:T chat.regenerate}" Command="{Binding RegenerateCommand}"
                  IsVisible="{Binding IsIdle}" />
          <Button x:Name="SendButton" Classes="accent" Content="{l:T chat.send}" Command="{Binding SendCommand}"
                  IsVisible="{Binding IsIdle}" />
          <Button x:Name="StopButton" Content="{l:T chat.stop}" Command="{Binding StopCommand}"
                  IsVisible="{Binding IsGenerating}" />
        </StackPanel>
      </Grid>

      <TextBlock DockPanel.Dock="Bottom" Margin="12,0" FontSize="11" Opacity="0.5" Text="{l:T chat.drop_hint}" />

      <!-- Сообщения -->
      <ScrollViewer x:Name="MessagesScroll" Margin="12,0">
        <ItemsControl x:Name="MessageList" ItemsSource="{Binding Messages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MessageViewModel">
              <Border Margin="0,6" Padding="12,8" CornerRadius="8"
                      Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                      Classes.user="{Binding IsUser}">
                <StackPanel Spacing="4">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Author}" />
                    <Button Grid.Column="1" Padding="6,0" Content="{l:T chat.copy}"
                            IsVisible="{Binding IsAssistant}"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CopyCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                  <Expander Header="{l:T chat.thinking}" IsVisible="{Binding HasReasoning}"
                            IsExpanded="{Binding IsThinkingOpen}" HorizontalAlignment="Stretch">
                    <SelectableTextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding Reasoning}" />
                  </Expander>
                  <SelectableTextBlock TextWrapping="Wrap" Text="{Binding Content}" />
                  <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AttachmentViewModel">
                        <TextBlock FontSize="12" Opacity="0.7" Text="{Binding Label}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock FontSize="12" Opacity="0.7" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- Настройки (3.7): поверх окна -->
    <Border x:Name="SettingsPanel" Grid.ColumnSpan="3" ZIndex="9" IsVisible="{Binding Settings.IsOpen}"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
      <ScrollViewer>
        <StackPanel MaxWidth="640" Margin="24" Spacing="10" HorizontalAlignment="Center">
          <TextBlock FontSize="22" FontWeight="SemiBold" Text="{l:T settings.title}" />

          <TextBlock FontWeight="SemiBold" Text="{l:T settings.data_dir}" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="DataDirBox" Text="{Binding Settings.DataDir}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Content="{l:T settings.browse}"
                    Command="{Binding Settings.BrowseDataDirCommand}" />
          </Grid>
          <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap" Text="{Binding Settings.DataDirNote}" />

          <TextBlock FontWeight="SemiBold" Text="{l:T settings.models_dir}" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="ModelsDirBox" Text="{Binding Settings.ModelsDir}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Content="{l:T settings.browse}"
                    Command="{Binding Settings.BrowseModelsDirCommand}" />
          </Grid>

          <TextBlock FontWeight="SemiBold" Text="{l:T settings.language}" />
          <ComboBox x:Name="LanguageBox" MinWidth="200" ItemsSource="{Binding Settings.Languages}"
                    SelectedItem="{Binding Settings.Language}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LanguageOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock FontWeight="SemiBold" Text="{l:T settings.api_port}" />
          <TextBox x:Name="ApiPortBox" MaxWidth="160" HorizontalAlignment="Left" Text="{Binding Settings.ApiPort}" />
          <CheckBox x:Name="NetworkBox" Content="{l:T settings.network_access}" IsChecked="{Binding Settings.NetworkAccess}" />
          <TextBlock FontSize="12" Classes="warn" TextWrapping="Wrap" Text="{l:T settings.network_warning}"
                     IsVisible="{Binding Settings.NetworkAccess}" />
          <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap" Text="{l:T settings.api_note}" />

          <TextBlock x:Name="SettingsError" Classes="error" TextWrapping="Wrap" Text="{Binding Settings.Error}"
                     IsVisible="{Binding Settings.HasError}" />
          <TextBlock x:Name="SettingsMessage" TextWrapping="Wrap" Text="{Binding Settings.Message}"
                     IsVisible="{Binding Settings.HasMessage}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="RestartButton" Content="{l:T settings.restart_now}" Command="{Binding Settings.RestartCommand}"
                    IsVisible="{Binding Settings.RestartNeeded}" />
            <Button x:Name="SettingsClose" Content="{l:T settings.cancel}" Command="{Binding Settings.CloseCommand}" />
            <Button x:Name="SettingsSave" Classes="accent" Content="{l:T settings.save}"
                    Command="{Binding Settings.SaveCommand}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Мастер первого запуска (UI-01, 3.6): поверх всего окна -->
    <Border x:Name="Onboarding" Grid.ColumnSpan="3" ZIndex="10" IsVisible="{Binding Onboarding.IsOpen}"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
      <ScrollViewer>
        <StackPanel MaxWidth="640" Margin="24" Spacing="12" HorizontalAlignment="Center">
          <TextBlock FontSize="22" FontWeight="SemiBold" Text="{l:T onboarding.title}" />

          <!-- Шаг 1: проверка компьютера -->
          <StackPanel x:Name="CheckStep" Spacing="8" IsVisible="{Binding Onboarding.IsCheckStep}">
            <TextBlock FontWeight="SemiBold" Text="{l:T onboarding.check_title}" />
            <TextBlock Opacity="0.7" Text="{l:T onboarding.checking}" IsVisible="{Binding Onboarding.IsChecking}" />
            <ItemsControl x:Name="CheckList" ItemsSource="{Binding Onboarding.Checks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CheckItem">
                  <Grid ColumnDefinitions="28,*" Margin="0,3">
                    <TextBlock FontWeight="Bold" Text="{Binding Mark}"
                               Classes.ok="{Binding IsOk}" Classes.warn="{Binding IsWarn}" Classes.fail="{Binding IsFail}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding Text}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button x:Name="SkipButton1" Content="{l:T onboarding.skip}" Command="{Binding Onboarding.SkipCommand}" />
              <Button x:Name="NextButton" Classes="accent" Content="{l:T onboarding.next}"
                      Command="{Binding Onboarding.NextCommand}" />
            </StackPanel>
          </StackPanel>

          <!-- Шаг 2: модель -->
          <StackPanel x:Name="ModelStep" Spacing="8" IsVisible="{Binding Onboarding.IsModelStep}">
            <TextBlock FontWeight="SemiBold" Text="{l:T onboarding.model_title}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{l:T onboarding.no_models}"
                       IsVisible="{Binding !Onboarding.HasModels}" />
            <ListBox x:Name="WizardModels" ItemsSource="{Binding Onboarding.Models}" MaxHeight="240"
                     SelectedItem="{Binding Onboarding.Selected}" IsVisible="{Binding Onboarding.HasModels}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="api:ModelInfo">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Id}" />
                    <TextBlock Opacity="0.6" Text="{Binding Quant}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button x:Name="ImportButton" Content="{l:T onboarding.import}" Command="{Binding Onboarding.ImportCommand}" />
            <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap" Text="{l:T onboarding.import_note}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button x:Name="BackButton" Content="{l:T onboarding.back}" Command="{Binding Onboarding.BackCommand}" />
              <Button x:Name="SkipButton2" Content="{l:T onboarding.skip}" Command="{Binding Onboarding.SkipCommand}" />
              <Button x:Name="StartButton" Classes="accent" Content="{l:T onboarding.start}"
                      Command="{Binding Onboarding.StartCommand}" />
            </StackPanel>
          </StackPanel>

          <TextBlock x:Name="OnboardingError" Classes="error" TextWrapping="Wrap"
                     Text="{Binding Onboarding.Error}" IsVisible="{Binding Onboarding.HasError}" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>

  <Window.Styles>
    <Style Selector="TextBlock.ok">
      <Setter Property="Foreground" Value="#2E7D32" />
    </Style>
    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="#B26A00" />
    </Style>
    <Style Selector="TextBlock.fail">
      <Setter Property="Foreground" Value="#C62828" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#C62828" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.problem">
      <Setter Property="BorderBrush" Value="#C62828" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.user">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
    </Style>
  </Window.Styles>
</Window>
