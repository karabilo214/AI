<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Ramvi.Desktop.Localization"
        xmlns:vm="using:Ramvi.Desktop.ViewModels"
        xmlns:api="using:Ramvi.Desktop.Api"
        xmlns:views="using:Ramvi.Desktop.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="Ramvi.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{l:T app.title}"
        Icon="avares://RAMVI/Assets/ramvi-emblem.png"
        Width="1180" Height="760" MinWidth="760" MinHeight="500"
        ExtendClientAreaToDecorationsHint="True"
        DragDrop.AllowDrop="True">
  <Grid RowDefinitions="Auto,*">
  <!--
    Полоса заголовка в фоне приложения (3.16, вариант 1): окно расширено в область заголовка,
    кнопки «свернуть/развернуть/закрыть» остаются системными, высота — системная.
    Роль TitleBar: перетаскивание, двойной щелчок и прилипание к краям делает система.
  -->
  <Border x:Name="TitleBar" Grid.Row="0" Background="Transparent"
          Height="{Binding $parent[Window].WindowDecorationMargin.Top}"
          chrome:WindowDecorationProperties.ElementRole="TitleBar">
    <TextBlock Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center"
               IsHitTestVisible="False" Text="{l:T app.title}" />
  </Border>
  <!-- Раскладка по иллюстрации ТЗ «Главный экран»: меню слева, чат справа (3.16, неоморфизм) -->
  <Grid Grid.Row="1" ColumnDefinitions="288,*">

    <!-- Меню: логотип, разделы, диалоги, настройки -->
    <Border Grid.Column="0" Classes="sidebar">
      <DockPanel Margin="14,18,14,14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6,0,0,14">
          <Image Source="avares://RAMVI/Assets/ramvi-emblem.png" Width="36" Height="36" />
          <TextBlock Classes="brand" VerticalAlignment="Center" Text="{l:T app.title}" />
        </StackPanel>

        <!-- Разделы (3.11): видны, только если их больше одного -->
        <Border x:Name="SectionRail" DockPanel.Dock="Top" Margin="0,0,0,10" IsVisible="{Binding Sections.HasMany}">
          <ListBox x:Name="SectionList" Classes="nav"
                   ItemsSource="{Binding Sections.Items}" SelectedItem="{Binding Sections.Selected}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SectionItem">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
          <Button x:Name="SettingsButton" Grid.Column="1" Classes="icon"
                  ToolTip.Tip="{l:T settings.open}" Command="{Binding OpenSettingsCommand}">
            <PathIcon Data="{StaticResource icon-settings}" />
          </Button>
        </Grid>

        <DockPanel IsVisible="{Binding Sections.IsChatSelected}">
          <Button x:Name="NewChatButton" DockPanel.Dock="Top" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left" Margin="4,0,4,12" Command="{Binding NewChatCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource icon-plus}" />
              <TextBlock VerticalAlignment="Center" Text="{l:T chat.new}" />
            </StackPanel>
          </Button>
          <TextBlock DockPanel.Dock="Top" Classes="caption" Margin="12,4" Text="{l:T chat.no_chats}"
                     IsVisible="{Binding !HasChats}" />
          <ListBox x:Name="ChatList" Classes="nav" ItemsSource="{Binding Chats}" SelectedItem="{Binding SelectedChat}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ChatItemViewModel">
                <Grid ColumnDefinitions="*,Auto" Background="Transparent">
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{l:T chat.delete_hint}"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteChatCommand}"
                                CommandParameter="{Binding}" />
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <TextBlock VerticalAlignment="Center" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <!-- (6) крестик удаления прямо в списке, с подсказкой -->
                  <Button Grid.Column="1" Classes="icon flat row-action" Margin="6,0,0,0"
                          ToolTip.Tip="{l:T chat.delete_hint}"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DeleteChatCommand}"
                          CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource icon-close}" Width="12" Height="12" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </DockPanel>
    </Border>

    <!-- Раздел модуля (Agent/Character): вид создаётся при первом открытии и хранится -->
    <Border x:Name="ModuleSection" Grid.Column="1" Classes="card" Margin="8,4,16,16"
            IsVisible="{Binding Sections.IsPlaceholderSelected}">
      <StackPanel Margin="28" Spacing="8" DataContext="{Binding Sections.Current}" x:DataType="vm:ModuleSectionViewModel">
        <TextBlock x:Name="ModuleTitle" Classes="title" Text="{Binding Title, FallbackValue=''}" />
        <TextBlock x:Name="ModuleState" Classes="muted" Text="{Binding State, FallbackValue=''}" />
        <TextBlock x:Name="ModuleError" Classes="error" TextWrapping="Wrap" Text="{Binding Error, FallbackValue=''}"
                   IsVisible="{Binding HasError, FallbackValue=False}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Placeholder, FallbackValue=''}" />
      </StackPanel>
    </Border>


    <Border x:Name="AgentPanel" Grid.Column="1" Classes="card" Margin="8,4,16,16" IsVisible="{Binding Sections.IsAgentSelected}">
      <views:AgentView DataContext="{Binding Agent}"/>
    </Border>

    <!-- Диалог -->
    <DockPanel x:Name="ChatPanel" Grid.Column="1" Margin="8,4,16,16" IsVisible="{Binding Sections.IsChatSelected}">
      <!-- Верхняя полоса: модель; справа значки «Очистить» и «Удалить» с подсказками -->
      <Grid DockPanel.Dock="Top" Margin="0,0,0,8" ColumnDefinitions="Auto,*,Auto,Auto">
        <Border Classes="chip" Margin="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock VerticalAlignment="Center" Classes="muted" Text="{l:T chat.model}" />
            <ComboBox x:Name="ModelBox" MinWidth="220" BorderThickness="0" Background="Transparent"
                      ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                      IsDropDownOpen="{Binding IsModelPickerOpen}"
                      IsEnabled="{Binding IsIdle}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="api:ModelInfo">
                  <TextBlock Text="{Binding Id}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- 3.17: модель загружается — крутится значок; подсказка называет модель -->
            <Border x:Name="LoadingSpinner" Background="Transparent" VerticalAlignment="Center" Margin="0,0,6,0"
                    IsVisible="{Binding IsModelLoading}" ToolTip.Tip="{Binding LoadingTip}">
              <PathIcon Classes="spinner" Data="{StaticResource icon-loading}">
                <PathIcon.RenderTransform>
                  <RotateTransform />
                </PathIcon.RenderTransform>
              </PathIcon>
            </Border>
          </StackPanel>
        </Border>
        <Button x:Name="ClearButton" Grid.Column="2" Classes="icon" ToolTip.Tip="{l:T chat.clear_hint}"
                Command="{Binding ClearCommand}">
          <PathIcon Data="{StaticResource icon-clear}" />
        </Button>
        <Button x:Name="DeleteButton" Grid.Column="3" Classes="icon" ToolTip.Tip="{l:T chat.delete_hint}"
                Command="{Binding DeleteChatCommand}">
          <PathIcon Data="{StaticResource icon-delete}" />
        </Button>
      </Grid>

      <!-- Плашка состояния UI-03: что случилось и кнопки восстановления -->
      <Border x:Name="StateBanner" DockPanel.Dock="Top" Classes="banner" Margin="4,0,4,10" Padding="14,10"
              IsVisible="{Binding HasBanner}"
              Classes.problem="{Binding Banner.IsProblem, FallbackValue=False}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock x:Name="StateTitle" Classes="heading" Text="{Binding Banner.Title, FallbackValue=''}" />
            <TextBlock x:Name="StateText" TextWrapping="Wrap" Text="{Binding Banner.Text, FallbackValue=''}" />
          </StackPanel>
          <ItemsControl x:Name="StateActions" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                        ItemsSource="{Binding Banner.Actions, FallbackValue={x:Null}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StateAction">
                <Button Content="{Binding Label}" Command="{Binding Command}" CommandParameter="{Binding Parameter}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <!-- Строка состояния -->
      <Border DockPanel.Dock="Bottom" Classes="statusbar" Margin="4,10,4,0">
        <TextBlock x:Name="StatusText" Text="{Binding Status}" TextWrapping="Wrap" Classes.error="{Binding IsError}" />
      </Border>

      <!-- Поле ввода: вложения, текст, «Прикрепить файл», «Отправить»/«Стоп» -->
      <Border x:Name="Composer" DockPanel.Dock="Bottom" Classes="composer" Margin="4,8,4,0">
        <Grid RowDefinitions="Auto,Auto,Auto">
          <ItemsControl Grid.Row="0" ItemsSource="{Binding Attachments}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AttachmentViewModel">
                <Border Classes="chip" Margin="4,4,6,6">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource icon-attach}" Width="12" Height="12" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                    <Button Classes="icon flat" ToolTip.Tip="{l:T chat.remove_attachment}"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveAttachmentCommand}"
                            CommandParameter="{Binding}">
                      <PathIcon Data="{StaticResource icon-close}" Width="10" Height="10" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBox x:Name="InputBox" Grid.Row="1" Classes="bare" MinHeight="40" MaxHeight="200"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   PlaceholderText="{l:T chat.input_placeholder}" Text="{Binding Input}" />
          <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="AttachButton" Classes="icon" Command="{Binding AttachFilesCommand}"
                      ToolTip.Tip="{l:T chat.attach_hint}">
                <PathIcon Data="{StaticResource icon-attach}" />
              </Button>
              <!-- 5.2: микрофон — первое нажатие пишет, второе распознаёт в поле ввода -->
              <Button x:Name="MicButton" Classes="icon" IsVisible="{Binding !Voice.IsRecording}"
                      Command="{Binding Voice.ToggleCommand}" ToolTip.Tip="{Binding Voice.Tip}">
                <PathIcon Data="{StaticResource icon-microphone}" />
              </Button>
            </StackPanel>
            <!-- 5.7: пока выбрано распознавание через API — метка, куда уходит звук -->
            <TextBlock x:Name="VoiceRemoteLabel" Grid.Column="1" Classes="warn" FontSize="12" VerticalAlignment="Center"
                       Margin="6,0" TextTrimming="CharacterEllipsis" Text="{Binding Voice.RemoteText}"
                       IsVisible="{Binding Voice.ShowRemote}" />
            <!-- 5.2: идёт распознавание -->
            <StackPanel x:Name="TranscribingIndicator" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" Margin="6,0" IsVisible="{Binding Voice.IsTranscribing}">
              <PathIcon Classes="spinner" Data="{StaticResource icon-loading}">
                <PathIcon.RenderTransform>
                  <RotateTransform />
                </PathIcon.RenderTransform>
              </PathIcon>
              <TextBlock VerticalAlignment="Center" Text="{l:T voice.transcribing}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button x:Name="SendButton" Classes="accent" Command="{Binding SendCommand}" IsVisible="{Binding IsIdle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource icon-send}" />
                  <TextBlock VerticalAlignment="Center" Text="{l:T chat.send}" />
                </StackPanel>
              </Button>
              <Button x:Name="StopButton" Command="{Binding StopCommand}" IsVisible="{Binding IsGenerating}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource icon-stop}" />
                  <TextBlock VerticalAlignment="Center" Text="{l:T chat.stop}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <!-- Идёт запись: большая «Остановить» посередине поля ввода, чтобы было ясно, что нажать -->
          <Border x:Name="RecordingOverlay" Grid.Row="0" Grid.RowSpan="3" Classes="recording-overlay"
                  IsVisible="{Binding Voice.IsRecording}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel x:Name="RecordingIndicator" Orientation="Horizontal" Spacing="16"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BigStopButton" Classes="icon recording big" Command="{Binding Voice.ToggleCommand}"
                        ToolTip.Tip="{l:T voice.stop_hint}">
                  <PathIcon Data="{StaticResource icon-stop}" Width="28" Height="28" />
                </Button>
                <StackPanel VerticalAlignment="Center" Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Classes="recording-dot" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{l:T voice.recording}" />
                    <TextBlock x:Name="RecordingTime" VerticalAlignment="Center" Text="{Binding Voice.Elapsed}" />
                  </StackPanel>
                  <ProgressBar x:Name="RecordingLevel" Width="140" MinWidth="140" Minimum="0" Maximum="1"
                               Value="{Binding Voice.Level}" />
                  <TextBlock Classes="caption" Text="{l:T voice.stop_big}" />
                </StackPanel>
              </StackPanel>
              <Button x:Name="CancelRecordingButton" Grid.Column="1" Classes="icon flat" VerticalAlignment="Top"
                      Command="{Binding Voice.CancelCommand}" ToolTip.Tip="{l:T voice.cancel_hint}">
                <PathIcon Data="{StaticResource icon-close}" Width="12" Height="12" />
              </Button>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- Сообщения; окно следует за печатающимся ответом (MainWindow.axaml.cs) -->
      <ScrollViewer x:Name="MessagesScroll">
        <StackPanel Margin="14,4,14,8">
          <ItemsControl x:Name="MessageList" ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MessageViewModel">
                <Border Classes="bubble" Classes.user="{Binding IsUser}">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="caption" Text="{Binding Author}" />
                    <StackPanel Spacing="6" IsVisible="{Binding HasReasoning}">
                      <ToggleButton Classes="disclosure" IsChecked="{Binding IsThinkingOpen}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <PathIcon Data="{StaticResource icon-chevron}" Width="12" Height="12" />
                          <TextBlock Classes="caption" VerticalAlignment="Center" Text="{l:T chat.thinking}" />
                        </StackPanel>
                      </ToggleButton>
                      <Border Classes="thinking" IsVisible="{Binding IsThinkingOpen}">
                        <SelectableTextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Reasoning}" />
                      </Border>
                    </StackPanel>
                    <SelectableTextBlock TextWrapping="Wrap" Text="{Binding Content}" />
                    <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AttachmentViewModel">
                          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                            <PathIcon Data="{StaticResource icon-attach}" Width="12" Height="12" />
                            <TextBlock Classes="caption" Text="{Binding Label}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
                    <!-- Под допечатанным ответом: копировать; у последнего — «Ответить заново» -->
                    <StackPanel Orientation="Horizontal" Margin="-4,0,0,-4" IsVisible="{Binding ShowActions}">
                      <Button Classes="icon" ToolTip.Tip="{l:T chat.copy}"
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CopyCommand}"
                              CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource icon-copy}" Width="14" Height="14" />
                      </Button>
                      <Button Classes="icon" ToolTip.Tip="{l:T chat.regenerate_hint}" IsVisible="{Binding ShowRegenerate}"
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RegenerateCommand}">
                        <PathIcon Data="{StaticResource icon-regenerate}" Width="14" Height="14" />
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- (3) признак «печатает…»: пока идёт ответ, текст ещё не окончательный -->
          <StackPanel x:Name="TypingIndicator" Orientation="Horizontal" Spacing="6" Margin="6,6,0,0"
                      IsVisible="{Binding IsGenerating}">
            <Ellipse Classes="dot" VerticalAlignment="Center" />
            <Ellipse Classes="dot d2" VerticalAlignment="Center" />
            <Ellipse Classes="dot d3" VerticalAlignment="Center" />
            <TextBlock Classes="caption" VerticalAlignment="Center" Margin="4,0,0,0" Text="{l:T chat.typing}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>

    <!-- Настройки (3.7): поверх окна; вкладки «Общие», «Звук», «Модели», «Подключения» и вкладки модулей.
         Шапка со значком «Закрыть» и низ с «Сохранить» не прокручиваются. -->
    <Border x:Name="SettingsPanel" Grid.ColumnSpan="2" ZIndex="9" Classes="overlay" IsVisible="{Binding Settings.IsOpen}">
      <Border x:Name="SettingsCard" Classes="card" MaxWidth="920" Margin="24" Padding="0"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="28,18,16,4">
            <TextBlock Classes="title" VerticalAlignment="Center" Text="{l:T settings.title}" />
            <Button x:Name="SettingsClose" Grid.Column="1" Classes="icon" ToolTip.Tip="{l:T settings.cancel}"
                    Command="{Binding Settings.CloseCommand}">
              <PathIcon Data="{StaticResource icon-close}" />
            </Button>
          </Grid>
          <ListBox x:Name="SettingsTabs" Grid.Row="1" Classes="nav" Margin="20,0,20,6"
                   ItemsSource="{Binding Settings.Tabs}" SelectedItem="{Binding Settings.SelectedTab}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingsTab">
                <TextBlock Text="{Binding Title}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Panel Grid.Row="2">
            <ScrollViewer x:Name="GeneralTab" IsVisible="{Binding Settings.IsGeneralTab}">
              <StackPanel Spacing="10" Margin="28,8,28,12">
                <TextBlock Classes="heading" Text="{l:T settings.data_dir}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox x:Name="DataDirBox" Text="{Binding Settings.DataDir}" />
                  <Button Grid.Column="1" Margin="8,0,0,0" Content="{l:T settings.browse}"
                          Command="{Binding Settings.BrowseDataDirCommand}" />
                </Grid>
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Settings.DataDirNote}" />

                <TextBlock Classes="heading" Text="{l:T settings.models_dir}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox x:Name="ModelsDirBox" Text="{Binding Settings.ModelsDir}" />
                  <Button Grid.Column="1" Margin="8,0,0,0" Content="{l:T settings.browse}"
                          Command="{Binding Settings.BrowseModelsDirCommand}" />
                </Grid>

                <TextBlock Classes="heading" Text="{l:T settings.default_model}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <ComboBox x:Name="DefaultModelBox" MinWidth="240" ItemsSource="{Binding Settings.Models}"
                            SelectedItem="{Binding Settings.DefaultModel}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="api:ModelInfo">
                        <TextBlock Text="{Binding Id}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button x:Name="ManageModelsButton" Content="{l:T settings.manage_models}"
                          Command="{Binding Settings.ManageModelsCommand}" />
                </StackPanel>

                <TextBlock Classes="heading" Text="{l:T settings.onboarding}" />
                <Button x:Name="OpenOnboardingButton" HorizontalAlignment="Left" Content="{l:T settings.onboarding_open}"
                        Command="{Binding Settings.OpenOnboardingCommand}" />
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:T settings.onboarding_note}" />

                <!-- 3.17: модель держится в памяти до выбора другой, выгрузки или выхода -->
                <TextBlock Classes="heading" Text="{l:T settings.model}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="UnloadModelButton" Classes="icon" ToolTip.Tip="{l:T settings.unload_model}"
                          Command="{Binding Settings.UnloadModelCommand}">
                    <PathIcon Data="{StaticResource icon-eject}" />
                  </Button>
                  <TextBlock x:Name="LoadedModelText" VerticalAlignment="Center" Text="{Binding Settings.LoadedModelText}" />
                </StackPanel>

                <TextBlock Classes="heading" Text="{l:T settings.language}" />
                <ComboBox x:Name="LanguageBox" MinWidth="200" ItemsSource="{Binding Settings.Languages}"
                          SelectedItem="{Binding Settings.Language}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LanguageOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Classes="heading" Text="{l:T settings.theme}" />
                <ComboBox x:Name="ThemeBox" MinWidth="200" ItemsSource="{Binding Settings.Themes}"
                          SelectedItem="{Binding Settings.Theme}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ThemeOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="SoundTab" IsVisible="{Binding Settings.IsSoundTab}">
              <StackPanel Spacing="10" Margin="28,8,28,12">
                <!-- 5.2: голосовой ввод — микрофон, язык и модель распознавания (whisper.cpp, локально) -->
                <CheckBox x:Name="VoiceAutoSendBox" Content="{l:T voice.auto_send}" IsChecked="{Binding Settings.Sound.AutoSend}" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:T voice.auto_send_note}" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" >
                  <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,0" Text="{l:T voice.device}" />
                  <ComboBox x:Name="VoiceDeviceBox" Grid.Row="0" Grid.Column="1" MinWidth="240"
                            ItemsSource="{Binding Settings.Sound.Devices}" SelectedItem="{Binding Settings.Sound.Device}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:VoiceOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,0" Text="{l:T voice.language}" />
                  <ComboBox x:Name="VoiceLanguageBox" Grid.Row="1" Grid.Column="1" MinWidth="240"
                            ItemsSource="{Binding Settings.Sound.Languages}" SelectedItem="{Binding Settings.Sound.Language}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:VoiceOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="0,0,12,0" Text="{l:T voice.model}" />
                  <ComboBox x:Name="VoiceModelBox" Grid.Row="2" Grid.Column="1" MinWidth="240"
                            ItemsSource="{Binding Settings.Sound.Models}" SelectedItem="{Binding Settings.Sound.Model}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:VoiceOption">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <TextBlock VerticalAlignment="Center" Text="{l:T voice.backend}" />
                <ComboBox x:Name="VoiceBackendBox" MinWidth="320" ItemsSource="{Binding Settings.Sound.Backends}"
                          SelectedItem="{Binding Settings.Sound.Backend}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:VoiceOption">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <!-- 5.7: распознавание через сторонний API (OpenAI-совместимое /v1/audio/transcriptions) -->
                <StackPanel x:Name="VoiceApiPanel" Spacing="8" IsVisible="{Binding Settings.Sound.IsApi}">
                  <TextBlock Classes="warn" FontSize="12" TextWrapping="Wrap" Text="{Binding Settings.Sound.ApiWarning}" />
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,0" Text="{l:T voice.api_url}" />
                    <TextBox x:Name="VoiceApiUrlBox" Grid.Row="0" Grid.Column="1" Text="{Binding Settings.Sound.ApiUrl}"
                             PlaceholderText="{l:T voice.api_url_hint}" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,0" Text="{l:T voice.api_model}" />
                    <TextBox x:Name="VoiceApiModelBox" Grid.Row="1" Grid.Column="1" Text="{Binding Settings.Sound.ApiModel}" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="0,0,12,0" Text="{l:T voice.api_key}" />
                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto,Auto">
                      <TextBox x:Name="VoiceApiKeyBox" PasswordChar="•" Text="{Binding Settings.Sound.ApiKey}"
                               PlaceholderText="{l:T voice.api_key_hint}" />
                      <Button x:Name="VoiceApiKeySave" Grid.Column="1" Content="{l:T voice.api_key_save}"
                              Command="{Binding Settings.Sound.SaveKeyCommand}" />
                      <Button x:Name="VoiceApiKeyClear" Grid.Column="2" Classes="icon" ToolTip.Tip="{l:T voice.api_key_clear}"
                              Command="{Binding Settings.Sound.ClearKeyCommand}">
                        <PathIcon Data="{StaticResource icon-delete}" />
                      </Button>
                    </Grid>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="VoiceApiKeyStatus" Classes="caption" VerticalAlignment="Center" Text="{Binding Settings.Sound.KeyStatus}" />
                    <Button x:Name="VoiceApiCheck" Content="{l:T voice.api_check}" Command="{Binding Settings.Sound.CheckCommand}" />
                  </StackPanel>
                  <TextBlock x:Name="VoiceApiCheckResult" TextWrapping="Wrap" Text="{Binding Settings.Sound.CheckResult}"
                             IsVisible="{Binding Settings.Sound.HasCheckResult}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock x:Name="VoiceModelStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                             Text="{Binding Settings.Sound.ModelStatus}" />
                  <Button x:Name="VoiceDownloadButton" Classes="icon" ToolTip.Tip="{l:T voice.download}"
                          Command="{Binding Settings.Sound.DownloadCommand}" IsVisible="{Binding !Settings.Sound.IsDownloading}">
                    <PathIcon Data="{StaticResource icon-download}" />
                  </Button>
                  <Button x:Name="VoiceCancelDownloadButton" Classes="icon" ToolTip.Tip="{l:T voice.download_cancel}"
                          Command="{Binding Settings.Sound.CancelDownloadCommand}" IsVisible="{Binding Settings.Sound.IsDownloading}">
                    <PathIcon Data="{StaticResource icon-close}" />
                  </Button>
                </StackPanel>
                <!-- 5.4: ускоритель на видеокарте (Windows + NVIDIA) и где прошло последнее распознавание -->
                <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Settings.Sound.AccelOffered}">
                  <TextBlock VerticalAlignment="Center" Text="{l:T voice.accel}" />
                  <Button x:Name="VoiceAccelButton" Classes="icon" ToolTip.Tip="{l:T voice.accel_download}"
                          Command="{Binding Settings.Sound.DownloadAccelCommand}"
                          IsVisible="{Binding Settings.Sound.AccelMissing}">
                    <PathIcon Data="{StaticResource icon-download}" />
                  </Button>
                </StackPanel>
                <TextBlock x:Name="VoiceAccelStatus" Classes="caption" TextWrapping="Wrap" Text="{Binding Settings.Sound.AccelStatus}"
                           IsVisible="{Binding Settings.Sound.AccelOffered}" />
                <TextBlock x:Name="VoiceLast" Classes="caption" TextWrapping="Wrap" Text="{Binding Settings.Sound.LastText}"
                           IsVisible="{Binding Settings.Sound.HasLast}" />
                <TextBlock x:Name="VoiceError" Classes="error" TextWrapping="Wrap" Text="{Binding Settings.Sound.Error}"
                           IsVisible="{Binding Settings.Sound.HasError}" />
                <TextBlock x:Name="VoiceLocalNote" Classes="caption" TextWrapping="Wrap" Text="{l:T voice.note}"
                       IsVisible="{Binding !Settings.Sound.IsApi}" />
              </StackPanel>
            </ScrollViewer>
            <DockPanel x:Name="ModelsPanel" Margin="24,8,24,16" IsVisible="{Binding Settings.IsModelsTab}">
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" Text="{l:T models.tab_note}" />
                <Button x:Name="RefreshCatalogButton" Grid.Column="1" Classes="icon" ToolTip.Tip="{l:T models.refresh}"
                        Command="{Binding ModelsScreen.RefreshCommand}">
                  <PathIcon Data="{StaticResource icon-refresh}" />
                </Button>
              </Grid>
              <Border DockPanel.Dock="Top" Classes="inset" Padding="12,8" Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <PathIcon Data="{StaticResource icon-search}" Width="16" Height="16" Margin="0,0,8,0" />
                  <TextBox x:Name="ModelSearch" Grid.Column="1" Classes="bare" PlaceholderText="{l:T models.search}"
                           Text="{Binding ModelsScreen.Search}" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="FilterAll" Content="{l:T models.filter.all}" Classes.accent="{Binding ModelsScreen.IsAll}"
                            Command="{Binding ModelsScreen.FilterCommand}" CommandParameter="all" />
                    <Button x:Name="FilterInstalled" Content="{l:T models.filter.installed}"
                            Classes.accent="{Binding ModelsScreen.IsInstalledFilter}"
                            Command="{Binding ModelsScreen.FilterCommand}" CommandParameter="installed" />
                    <Button x:Name="FilterSuitable" Content="{l:T models.filter.suitable}"
                            Classes.accent="{Binding ModelsScreen.IsSuitableFilter}"
                            Command="{Binding ModelsScreen.FilterCommand}" CommandParameter="suitable" />
                  </StackPanel>
                </Grid>
              </Border>
              <!-- Нижняя строка: выбор модели для профиля задачи (4.6) и пометка устаревшего каталога -->
              <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,0">
                <TextBlock x:Name="ModelsError" Classes="error" TextWrapping="Wrap" Text="{Binding ModelsScreen.Error}"
                           IsVisible="{Binding ModelsScreen.HasError}" />
                <TextBlock x:Name="CatalogStale" Classes="warn" TextWrapping="Wrap" Text="{l:T models.stale}"
                           IsVisible="{Binding ModelsScreen.IsStale}" />
                <Border Classes="inset" Padding="12,8">
                  <TextBlock x:Name="ModelsRecommendation" TextWrapping="Wrap" Text="{Binding ModelsScreen.Recommendation}" />
                </Border>
              </StackPanel>
              <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="4" Text="{l:T models.empty}"
                         IsVisible="{Binding ModelsScreen.IsEmpty}" />
              <ScrollViewer>
                <ItemsControl x:Name="ModelCards" ItemsSource="{Binding ModelsScreen.Cards}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModelCardViewModel">
                      <Border Classes="inset" Margin="2,4" Padding="14,12" ToolTip.Tip="{Binding Reasons}">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                          <Border Grid.RowSpan="2" Classes="chip" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Top">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Text="AI" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Classes="heading" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Detail}" />
                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Measured}"
                                       IsVisible="{Binding HasMeasured}" />
                            <TextBlock FontSize="12" Text="{Binding CompatText}" Classes.ok="{Binding IsRecommended}"
                                       Classes.warn="{Binding IsSlow}" Classes.fail="{Binding IsUnfit}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right">
                            <Border Classes="chip" Classes.current="{Binding IsCurrentChip}" HorizontalAlignment="Right">
                              <TextBlock FontSize="12" Text="{Binding StateText}" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                              <Button Classes="accent" Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <PathIcon Data="{StaticResource icon-download}" />
                                  <TextBlock VerticalAlignment="Center" Text="{l:T models.download}" />
                                </StackPanel>
                              </Button>
                              <Button Classes="icon" ToolTip.Tip="{l:T models.pause}" Command="{Binding PauseCommand}"
                                      IsVisible="{Binding IsDownloading}">
                                <PathIcon Data="{StaticResource icon-pause}" />
                              </Button>
                              <Button Classes="icon" ToolTip.Tip="{l:T models.resume}" Command="{Binding ResumeCommand}"
                                      IsVisible="{Binding IsPaused}">
                                <PathIcon Data="{StaticResource icon-play}" />
                              </Button>
                              <Button Classes="icon" ToolTip.Tip="{l:T models.cancel}" Command="{Binding CancelCommand}"
                                      IsVisible="{Binding HasProgress}">
                                <PathIcon Data="{StaticResource icon-close}" />
                              </Button>
                              <Button Classes="icon" ToolTip.Tip="{l:T models.make_default}" Command="{Binding MakeDefaultCommand}"
                                      IsVisible="{Binding IsInstalled}">
                                <PathIcon Data="{StaticResource icon-star}" />
                              </Button>
                              <Button ToolTip.Tip="{Binding DeleteHint}" Command="{Binding DeleteCommand}"
                                      IsVisible="{Binding IsInstalled}" Content="{Binding DeleteLabel}" />
                            </StackPanel>
                          </StackPanel>
                          <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4" Margin="0,8,0,0"
                                      IsVisible="{Binding HasProgress}">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6" />
                            <TextBlock Classes="caption" Text="{Binding ProgressText}" />
                          </StackPanel>
                          <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Classes="error" TextWrapping="Wrap"
                                     Margin="0,8,0,0" Text="{Binding DownloadError}" IsVisible="{Binding HasDownloadError}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
            <!-- 7.1–7.4: «Подключения» — внешний API для IDE и агентов: адрес, порт, сеть, ключи программ -->
            <ScrollViewer x:Name="ConnectionsTab" IsVisible="{Binding Settings.IsConnectionsTab}">
              <StackPanel Spacing="10" Margin="28,8,28,12">
                <TextBlock x:Name="ApiStatus" Classes="heading" TextWrapping="Wrap" Text="{Binding Settings.Connections.Status}" />
                <Border Classes="inset" Padding="14,10" IsVisible="{Binding Settings.Connections.HasUrl}">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:T connections.ide_note}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <TextBlock VerticalAlignment="Center" Text="{l:T connections.openai_url}" />
                      <SelectableTextBlock x:Name="OpenAiUrl" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Settings.Connections.OpenAiUrl}" />
                      <Button Grid.Column="2" Content="{l:T connections.copy}" Command="{Binding Settings.Connections.CopyUrlCommand}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <TextBlock VerticalAlignment="Center" Text="{l:T connections.base_url}" />
                      <SelectableTextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Settings.Connections.BaseUrl}" />
                    </Grid>
                    <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Settings.Connections.Queue}" />
                  </StackPanel>
                </Border>

                <TextBlock Classes="heading" Text="{l:T settings.api_port}" />
                <TextBox x:Name="ApiPortBox" MaxWidth="160" HorizontalAlignment="Left" Text="{Binding Settings.ApiPort}" />
                <CheckBox x:Name="NetworkBox" Content="{l:T settings.network_access}" IsChecked="{Binding Settings.NetworkAccess}" />
                <TextBlock FontSize="12" Classes="warn" TextWrapping="Wrap" Text="{l:T settings.network_warning}"
                           IsVisible="{Binding Settings.NetworkAccess}" />
                <StackPanel Spacing="4" IsVisible="{Binding Settings.NetworkAccess}">
                  <TextBlock Text="{l:T connections.allow}" />
                  <TextBox x:Name="NetworkAllowBox" Text="{Binding Settings.NetworkAllow}" />
                  <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:T connections.allow_note}" />
                </StackPanel>
                <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:T settings.api_note}" />

                <TextBlock Classes="heading" Margin="0,8,0,0" Text="{l:T connections.new_key}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox x:Name="NewKeyName" Watermark="{l:T connections.name_hint}" Text="{Binding Settings.Connections.NewName}" />
                  <Button x:Name="CreateKeyButton" Grid.Column="1" Classes="accent" Content="{l:T connections.create}"
                          Command="{Binding Settings.Connections.CreateCommand}" />
                </Grid>
                <ItemsControl x:Name="NewKeyRights" ItemsSource="{Binding Settings.Connections.NewPermissions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KeyRight">
                      <CheckBox Margin="0,0,16,0" Content="{Binding Label}" IsChecked="{Binding Enabled}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="NewKeyCard" Classes="inset" Padding="14,10" IsVisible="{Binding Settings.Connections.HasNewKey}">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="warn" TextWrapping="Wrap" Text="{l:T connections.key_once}" />
                    <SelectableTextBlock x:Name="NewKeyText" FontFamily="monospace" TextWrapping="Wrap" Text="{Binding Settings.Connections.NewKey}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="{l:T connections.copy}" Command="{Binding Settings.Connections.CopyKeyCommand}" />
                      <Button x:Name="DismissKeyButton" Content="{l:T connections.done}" Command="{Binding Settings.Connections.DismissKeyCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock Classes="heading" Margin="0,8,0,0" Text="{l:T connections.clients}" />
                <TextBlock Classes="muted" Text="{l:T connections.no_clients}" IsVisible="{Binding !Settings.Connections.HasClients}" />
                <ItemsControl x:Name="ClientList" ItemsSource="{Binding Settings.Connections.Clients}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClientRow">
                      <Border Classes="inset" Padding="14,10" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                              <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding KeyHint}" />
                              <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding State}" />
                            </StackPanel>
                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Permissions}" />
                            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Usage}" />
                            <TextBlock Classes="caption" Text="{Binding LastSeen}" />
                            <TextBlock Classes="caption" Text="{Binding Running}" IsVisible="{Binding HasRunning}" />
                          </StackPanel>
                          <Button Grid.Column="1" VerticalAlignment="Top" Content="{Binding RevokeLabel}"
                                  Command="{Binding RevokeCommand}" IsVisible="{Binding IsActive}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Settings.Connections.Error}"
                           IsVisible="{Binding Settings.Connections.HasError}" />
                <TextBlock TextWrapping="Wrap" Text="{Binding Settings.Connections.Message}"
                           IsVisible="{Binding Settings.Connections.HasMessage}" />
              </StackPanel>
            </ScrollViewer>
            <!-- Вкладка модуля: модули добавляют свои настройки (этапы 6 и 9) -->
            <Border IsVisible="{Binding Settings.IsAgentTab}"><views:AgentSettingsView DataContext="{Binding Agent}"/></Border>
            <StackPanel x:Name="ModuleSettingsTab" Margin="28,8" Spacing="8" IsVisible="{Binding Settings.IsModuleTab}">
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T settings.module_tab_note}" />
            </StackPanel>
          </Panel>
          <StackPanel Grid.Row="3" Spacing="8" Margin="28,6,28,18" IsVisible="{Binding Settings.HasFooter}">
            <TextBlock x:Name="SettingsError" Classes="error" TextWrapping="Wrap" Text="{Binding Settings.Error}"
                       IsVisible="{Binding Settings.HasError}" />
            <TextBlock x:Name="SettingsMessage" TextWrapping="Wrap" Text="{Binding Settings.Message}"
                       IsVisible="{Binding Settings.HasMessage}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="RestartButton" Content="{l:T settings.restart_now}" Command="{Binding Settings.RestartCommand}"
                      IsVisible="{Binding Settings.RestartNeeded}" />
              <Button x:Name="SettingsSave" Classes="accent" Content="{l:T settings.save}"
                      Command="{Binding Settings.SaveCommand}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <!-- Мастер первого запуска (UI-01, 3.6): поверх всего окна -->
    <Border x:Name="Onboarding" Grid.ColumnSpan="2" ZIndex="10" Classes="overlay" IsVisible="{Binding Onboarding.IsOpen}">
      <ScrollViewer>
        <Border Classes="card" MaxWidth="680" Margin="24" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Top">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Image Source="avares://RAMVI/Assets/ramvi-emblem.png" Width="48" Height="48" />
              <TextBlock Classes="title" VerticalAlignment="Center" Text="{l:T onboarding.title}" />
            </StackPanel>

            <!-- Шаг 1: проверка компьютера -->
            <StackPanel x:Name="CheckStep" Spacing="8" IsVisible="{Binding Onboarding.IsCheckStep}">
              <TextBlock Classes="heading" Text="{l:T onboarding.check_title}" />
              <TextBlock Classes="muted" Text="{l:T onboarding.checking}" IsVisible="{Binding Onboarding.IsChecking}" />
              <Border Classes="inset" Padding="14,10">
                <ItemsControl x:Name="CheckList" ItemsSource="{Binding Onboarding.Checks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CheckItem">
                      <Grid ColumnDefinitions="28,*" Margin="0,3">
                        <TextBlock FontWeight="Bold" Text="{Binding Mark}"
                                   Classes.ok="{Binding IsOk}" Classes.warn="{Binding IsWarn}" Classes.fail="{Binding IsFail}" />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding Text}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SkipButton1" Content="{l:T onboarding.skip}" Command="{Binding Onboarding.SkipCommand}" />
                <Button x:Name="NextButton" Classes="accent" Content="{l:T onboarding.next}"
                        Command="{Binding Onboarding.NextCommand}" />
              </StackPanel>
            </StackPanel>

            <!-- Шаг 2: модель -->
            <StackPanel x:Name="ModelStep" Spacing="8" IsVisible="{Binding Onboarding.IsModelStep}">
              <TextBlock Classes="heading" Text="{l:T onboarding.model_title}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T onboarding.no_models}"
                         IsVisible="{Binding !Onboarding.HasModels}" />
              <ListBox x:Name="WizardModels" Classes="nav" ItemsSource="{Binding Onboarding.Models}" MaxHeight="260"
                       SelectedItem="{Binding Onboarding.Selected}" IsVisible="{Binding Onboarding.HasModels}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="api:ModelInfo">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Id}" />
                      <TextBlock Classes="muted" Text="{Binding Quant}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button x:Name="ImportButton" HorizontalAlignment="Left" Content="{l:T onboarding.import}"
                      Command="{Binding Onboarding.ImportCommand}" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:T onboarding.import_note}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="{l:T onboarding.back}" Command="{Binding Onboarding.BackCommand}" />
                <Button x:Name="SkipButton2" Content="{l:T onboarding.skip}" Command="{Binding Onboarding.SkipCommand}" />
                <Button x:Name="StartButton" Classes="accent" Content="{l:T onboarding.start}"
                        Command="{Binding Onboarding.StartCommand}" />
              </StackPanel>
            </StackPanel>

            <TextBlock x:Name="OnboardingError" Classes="error" TextWrapping="Wrap"
                       Text="{Binding Onboarding.Error}" IsVisible="{Binding Onboarding.HasError}" />
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Border>
  </Grid>
  </Grid>
</Window>
