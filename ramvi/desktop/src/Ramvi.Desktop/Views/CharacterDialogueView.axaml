<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="using:Ramvi.Desktop.Localization" xmlns:vm="using:Ramvi.Desktop.ViewModels"
 xmlns:api="using:Ramvi.Desktop.Api" x:Class="Ramvi.Desktop.Views.CharacterDialogueView" x:DataType="vm:CharacterViewModel">
 <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="12,24,24,24" RowSpacing="12">
  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
   <StackPanel><TextBlock Text="{l:T character.model}"/><ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding Model}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="api:ModelInfo"><TextBlock Text="{Binding Id}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="{l:T character.profile}"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:CharacterProfile"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
  </Grid>
  <ScrollViewer x:Name="DialogueScroll" Grid.Row="1"><SelectableTextBlock x:Name="DialogueText" Text="{Binding Transcript}" TextWrapping="Wrap"/></ScrollViewer>
  <TextBlock Grid.Row="2" Text="{Binding Error}" Classes="error" TextWrapping="Wrap"/>
  <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
   <TextBox Text="{Binding Draft}" PlaceholderText="{l:T character.input}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="180"/>
   <StackPanel Grid.Column="1" Spacing="8"><Button Content="{l:T character.send}" Command="{Binding Send}"/><Button Content="{l:T character.stop}" Command="{Binding Stop}"/></StackPanel>
  </Grid>
 </Grid>
</UserControl>
