<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="using:Ramvi.Desktop.Localization" xmlns:vm="using:Ramvi.Desktop.ViewModels"
 xmlns:c="using:Ramvi.Desktop.Character" x:Class="Ramvi.Desktop.Views.CharacterView" x:DataType="vm:ModuleSectionViewModel">
 <Grid RowDefinitions="Auto,*" Margin="24" RowSpacing="12">
  <StackPanel Spacing="8">
   <TextBlock Classes="title" Text="{l:T section.character}"/>
   <TextBlock Text="{Binding State}" Classes="muted"/>
   <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="error" TextWrapping="Wrap"/>
   <TextBlock x:Name="CharacterError" Classes="error" TextWrapping="Wrap"/>
  </StackPanel>
  <c:CharacterCanvas Grid.Row="1" x:Name="CharacterSurface" MinHeight="120"/>

 </Grid>
</UserControl>
