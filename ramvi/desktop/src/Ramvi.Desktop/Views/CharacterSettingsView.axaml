<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="using:Ramvi.Desktop.Localization" xmlns:vm="using:Ramvi.Desktop.ViewModels"
 xmlns:api="using:Ramvi.Desktop.Api" xmlns:conv="using:Avalonia.Data.Converters" x:Class="Ramvi.Desktop.Views.CharacterSettingsView" x:DataType="vm:CharacterViewModel">
 <ScrollViewer Margin="24,8,24,16">
 <StackPanel Spacing="16">
  <TextBlock Text="{l:T character.profile}"/>
  <ComboBox x:Name="CharacterProfile" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:CharacterProfile"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
  <WrapPanel>
   <Button x:Name="CharacterChoosePack" Content="{l:T character.choose_pack}" Margin="0,0,8,8"/>
   <Button x:Name="CharacterDefaultPack" Content="{l:T character.default_pack}" Margin="0,0,8,8"/>
  </WrapPanel>
  <TextBlock Text="{Binding PackPath}" IsVisible="{Binding PackPath, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Classes="muted"/>
  <TextBlock x:Name="PackError" IsVisible="False" Classes="error" TextWrapping="Wrap"/>
   <StackPanel x:Name="SpeechSettings" DataContext="{Binding Speech}" x:DataType="vm:CharacterSpeechViewModel" HorizontalAlignment="Stretch">
     <TextBlock Text="{l:T character.speech_title}" Classes="heading"/>
     <StackPanel Spacing="8" Margin="0,8,0,0">
      <TextBlock Text="{l:T character.delivery_title}"/>
      <ComboBox x:Name="CharacterDelivery" ItemsSource="{Binding DeliveryModes}" SelectedItem="{Binding DeliveryMode}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:VoiceOption"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <TextBlock Text="{l:T character.delivery_buffer}"/>
      <ComboBox x:Name="CharacterBuffer" ItemsSource="{Binding Buffers}" SelectedItem="{Binding Buffer}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:VoiceOption"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <CheckBox Content="{l:T character.reactions}" IsChecked="{Binding Reactions}" IsEnabled="{Binding !IsExternal}"/>
      <TextBlock Text="{l:T character.reactions_hint}" TextWrapping="Wrap" Classes="muted"/>
      <CheckBox Content="{l:T character.speech_enable}" IsChecked="{Binding Enabled}"/>
      <TextBlock Text="{l:T character.speech_ai}" Classes="muted" TextWrapping="Wrap"/>
      <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SpeechProvider"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding Voice}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SpeechVoice"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <StackPanel IsVisible="{Binding IsExternal}" Spacing="8">
       <CheckBox Content="{l:T character.speech_remote}" IsChecked="{Binding RemoteText}"/>
       <TextBox Text="{Binding Key}" PasswordChar="●" PlaceholderText="{l:T character.speech_key}"/>
       <Button Content="{l:T character.speech_save_key}" Command="{Binding KeyCommand}"/>
      </StackPanel>
      <Button Content="{l:T character.speech_refresh}" Command="{Binding RefreshCommand}"/>
      <TextBlock Text="{Binding InventoryStatus}" TextWrapping="Wrap" Classes="muted"/>
      <TextBlock Text="{Binding Price}" TextWrapping="Wrap" Classes="muted"/>
      <SelectableTextBlock Text="{Binding Source}" TextWrapping="Wrap" Classes="muted"/>
      <WrapPanel><Button Content="{l:T character.speech_save}" Command="{Binding SaveCommand}" Margin="0,0,8,8"/><Button Content="{l:T character.speech_pause}" Command="{Binding StopCommand}" Margin="0,0,8,8"/></WrapPanel>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Fallback}" TextWrapping="Wrap" Classes="muted"/>
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Classes="error"/>
     </StackPanel>
   </StackPanel>
  <StackPanel x:Name="AgentSettings" DataContext="{Binding Agent}" x:DataType="vm:CharacterAgentViewModel" Spacing="8">
   <TextBlock Text="{l:T character.agent_title}" Classes="heading"/>
   <TextBlock Text="{l:T character.agent_hint}" TextWrapping="Wrap" Classes="muted"/>
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
    <TextBox x:Name="AgentFolder" Text="{Binding Folder}" PlaceholderText="{l:T character.agent_folder}"/>
    <Button Grid.Column="1" Content="{l:T character.agent_browse}" Command="{Binding BrowseCommand}"/>
   </Grid>
   <CheckBox x:Name="AgentEnabled" Content="{l:T character.agent_enabled}" IsChecked="{Binding Enabled}"/>
   <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Classes="error"/>
  </StackPanel>
  <StackPanel x:Name="MemorySettings" DataContext="{Binding Memory}" x:DataType="vm:CharacterMemoryViewModel" Spacing="8">
   <TextBlock Text="{l:T character.memory_title}" Classes="heading"/>
   <TextBlock Text="{l:T character.memory_hint}" TextWrapping="Wrap" Classes="muted"/>
   <WrapPanel>
    <Button x:Name="MemoryRefresh" Content="{l:T character.memory_refresh}" Command="{Binding RefreshCommand}" Margin="0,0,8,8"/>
    <Button x:Name="MemoryExport" Content="{l:T character.memory_export}" IsEnabled="{Binding Available}" Margin="0,0,8,8"/>
    <Button x:Name="MemoryClear" Content="{l:T character.memory_clear}" Command="{Binding ClearMemoryCommand}" IsEnabled="{Binding Available}" Margin="0,0,8,8"/>
   </WrapPanel>
   <StackPanel IsVisible="{Binding ClearMemoryArmed}" Spacing="8">
    <TextBlock Text="{l:T character.memory_clear_confirm}" TextWrapping="Wrap" Classes="error"/>
    <WrapPanel><Button x:Name="MemoryClearYes" Content="{l:T character.memory_clear_yes}" Command="{Binding ClearMemoryCommand}" Margin="0,0,8,8"/><Button Content="{l:T character.memory_cancel}" Command="{Binding CancelClearCommand}" Margin="0,0,8,8"/></WrapPanel>
   </StackPanel>
   <TextBlock Text="{l:T character.memory_empty}" IsVisible="{Binding NoRecords}" Classes="muted"/>
   <ItemsControl x:Name="MemoryRecords" ItemsSource="{Binding Records}">
    <ItemsControl.ItemTemplate>
     <DataTemplate x:DataType="vm:MemoryRecordItem">
      <StackPanel Spacing="4" Margin="0,0,0,12">
       <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Details}" Classes="muted" TextWrapping="Wrap"/>
       <TextBox Text="{Binding Value}" TextWrapping="Wrap" AcceptsReturn="False"/>
       <WrapPanel>
        <Button Content="{l:T character.memory_save}" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
        <Button Content="{l:T character.memory_confirm}" Command="{Binding ConfirmCommand}" IsVisible="{Binding !IsActive}" Margin="0,0,8,0"/>
        <Button Content="{l:T character.memory_forget}" Command="{Binding ForgetCommand}" Margin="0,0,8,0"/>
       </WrapPanel>
      </StackPanel>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
   <TextBlock Text="{l:T character.pref_title}" Classes="heading"/>
   <TextBlock Text="{l:T character.pref_hint}" TextWrapping="Wrap" Classes="muted"/>
   <TextBlock Text="{l:T character.pref_empty}" IsVisible="{Binding NoPreferences}" Classes="muted"/>
   <ItemsControl x:Name="Preferences" ItemsSource="{Binding Preferences}">
    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PreferenceItem"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,0,0,4"/></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <WrapPanel><Button x:Name="FeedbackClear" Content="{l:T character.pref_clear}" Command="{Binding ClearFeedbackCommand}" IsEnabled="{Binding !NoPreferences}" Margin="0,0,8,8"/></WrapPanel>
   <StackPanel x:Name="AdaptationSettings" IsVisible="{Binding AdaptationAvailable}" Spacing="8">
    <TextBlock Text="{l:T character.adapt_title}" Classes="heading"/>
    <TextBlock Text="{l:T character.adapt_hint}" TextWrapping="Wrap" Classes="muted"/>
    <CheckBox x:Name="AdaptationEnabled" Content="{l:T character.adapt_enabled}" IsChecked="{Binding AdaptationEnabled}"/>
    <TextBlock Text="{l:T character.adapt_off_hint}" IsVisible="{Binding !AdaptationEnabled}" TextWrapping="Wrap" Classes="muted"/>
    <TextBlock Text="{l:T character.adapt_empty}" IsVisible="{Binding NoCorrections}" Classes="muted"/>
    <ItemsControl x:Name="AdaptationCorrections" ItemsSource="{Binding Corrections}">
     <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:CorrectionItem"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,0,0,4"/></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <WrapPanel>
     <Button x:Name="AdaptationSave" Content="{l:T character.adapt_save}" Command="{Binding SaveAdaptationCommand}" Margin="0,0,8,8"/>
     <Button x:Name="AdaptationUndo" Content="{l:T character.adapt_undo}" Command="{Binding UndoAdaptationCommand}" Margin="0,0,8,8"/>
     <Button x:Name="AdaptationReset" Content="{l:T character.adapt_reset}" Command="{Binding ResetAdaptationCommand}" Margin="0,0,8,8"/>
    </WrapPanel>
    <StackPanel IsVisible="{Binding ResetArmed}" Spacing="8">
     <TextBlock Text="{l:T character.adapt_reset_confirm}" TextWrapping="Wrap" Classes="error"/>
     <WrapPanel><Button x:Name="AdaptationResetYes" Content="{l:T character.adapt_reset_yes}" Command="{Binding ResetAdaptationCommand}" Margin="0,0,8,8"/><Button Content="{l:T character.memory_cancel}" Command="{Binding CancelClearCommand}" Margin="0,0,8,8"/></WrapPanel>
    </StackPanel>
    <TextBlock Text="{l:T character.adapt_points}" FontWeight="SemiBold" IsVisible="{Binding HasSavedPoints}"/>
    <ItemsControl x:Name="AdaptationPoints" ItemsSource="{Binding SavedPoints}">
     <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:AdaptationPointItem">
       <WrapPanel Margin="0,0,0,6"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="{l:T character.adapt_restore}" Command="{Binding RestoreCommand}"/></WrapPanel>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{l:T character.adapt_history}" FontWeight="SemiBold"/>
    <TextBlock Text="{l:T character.adapt_history_empty}" IsVisible="{Binding NoAdaptationHistory}" Classes="muted"/>
    <ItemsControl x:Name="AdaptationHistory" ItemsSource="{Binding AdaptationHistory}">
     <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:AdaptationChangeItem">
       <WrapPanel Margin="0,0,0,6"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="{l:T character.adapt_restore_before}" Command="{Binding RestoreCommand}"/></WrapPanel>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
   <TextBlock Text="{l:T character.history_title}" Classes="heading"/>
   <WrapPanel><Button x:Name="HistoryClear" Content="{l:T character.history_clear}" Command="{Binding ClearHistoryCommand}" Margin="0,0,8,8"/></WrapPanel>
   <StackPanel IsVisible="{Binding ClearHistoryArmed}" Spacing="8">
    <TextBlock Text="{l:T character.history_clear_confirm}" TextWrapping="Wrap" Classes="error"/>
    <WrapPanel><Button x:Name="HistoryClearYes" Content="{l:T character.memory_clear_yes}" Command="{Binding ClearHistoryCommand}" Margin="0,0,8,8"/><Button Content="{l:T character.memory_cancel}" Command="{Binding CancelClearCommand}" Margin="0,0,8,8"/></WrapPanel>
   </StackPanel>
   <TextBlock Text="{l:T character.history_empty}" IsVisible="{Binding NoHistory}" Classes="muted"/>
   <ItemsControl x:Name="HistoryTurns" ItemsSource="{Binding History}">
    <ItemsControl.ItemTemplate>
     <DataTemplate x:DataType="vm:HistoryTurnItem">
      <StackPanel Spacing="2" Margin="0,0,0,10">
       <TextBlock Text="{Binding User}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Assistant}" Classes="muted" TextWrapping="Wrap"/>
       <Button Content="{l:T character.history_forget}" Command="{Binding ForgetCommand}" HorizontalAlignment="Left"/>
      </StackPanel>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Classes="error"/>
  </StackPanel>
  <CheckBox Content="{l:T character.diagnostics}" IsChecked="{Binding Diagnostics}"/>
 </StackPanel>
 </ScrollViewer>
</UserControl>
