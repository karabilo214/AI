<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ramvi.Desktop.App"
             Name="RAMVI"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://RAMVI/Themes/Palette.axaml" />
        <ResourceInclude Source="avares://RAMVI/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- Стандартные элементы (поля, списки, флажки) — в цветах палитры RAMVI (3.16) -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light"
                               Accent="#6928BD" RegionColor="#F7F5FB" AltHigh="#FFFFFF"
                               BaseHigh="#241735" BaseMediumHigh="#241735" BaseMedium="#685B78"
                               BaseMediumLow="#887997" BaseLow="#DDD4E8"
                               ChromeMediumLow="#EFEAF6" ChromeLow="#F7F5FB" ChromeMedium="#EFEAF6"
                               ListLow="#EFEAF6" ListMedium="#E9DAFC" ErrorText="#B12C49" />
        <ColorPaletteResources x:Key="Dark"
                               Accent="#B58AFF" RegionColor="#14101C" AltHigh="#1E172A"
                               BaseHigh="#F4EFFB" BaseMediumHigh="#F4EFFB" BaseMedium="#C0B2D0"
                               BaseMediumLow="#8A769F" BaseLow="#493959"
                               ChromeMediumLow="#322640" ChromeLow="#14101C" ChromeMedium="#291F38"
                               ListLow="#322640" ListMedium="#493066" ErrorText="#FF9FB1" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://RAMVI/Themes/Styles.axaml" />
  </Application.Styles>
</Application>
