      <Color x:Key="ramvi-shadow-light-color">#FFFFFF</Color>
      <SolidColorBrush x:Key="ramvi-shadow-light" Color="#FFFFFF" />
      <BoxShadows x:Key="ramvi-shadow-raised">6 6 14 0 #D6CCE6, -6 -6 14 0 #FFFFFF</BoxShadows>
      <BoxShadows x:Key="ramvi-shadow-raised-sm">3 3 7 0 #D6CCE6, -3 -3 7 0 #FFFFFF</BoxShadows>
      <BoxShadows x:Key="ramvi-shadow-inset">inset 3 3 6 0 #D6CCE6, inset -3 -3 6 0 #FFFFFF</BoxShadows>
