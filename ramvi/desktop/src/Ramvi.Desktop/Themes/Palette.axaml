      <SolidColorBrush x:Key="ramvi-on-primary" Color="#FFFFFF" />
      <Color x:Key="ramvi-accent-color">#FF8868</Color>
      <SolidColorBrush x:Key="ramvi-accent" Color="#FF8868" />
      <Color x:Key="ramvi-on-accent-color">#35162C</Color>
      <SolidColorBrush x:Key="ramvi-on-accent" Color="#35162C" />
      <Color x:Key="ramvi-focus-color">#793BE0</Color>
