<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Сгенерировано desktop/tools/palette_to_axaml.py из assets/branding/palette.json. Не править вручную. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="ramvi-background-color">#F7F5FB</Color>
      <SolidColorBrush x:Key="ramvi-background" Color="#F7F5FB" />
